# Copy this file to .env.local (git-ignored — never commit real values there)
# and fill in the values. Ask Ian or Uri for the project's actual values if
# you don't have them — same as whatever is set in Vercel's Environment
# Variables for this project.
#
# Restart `npm run dev` after creating/editing .env.local — Vite only reads
# env files at startup.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Web push (Fase 2 — notificaciones). Only the public key is needed here —
# it's safe to expose (that's the point of VAPID's public/private split).
# The private key (VAPID_PRIVATE_KEY) and the Supabase service role key
# (SUPABASE_SERVICE_ROLE_KEY) are server-only secrets used by
# api/send-push.ts and must NEVER go in this file or any VITE_-prefixed
# var — they're set directly in Vercel's dashboard instead.
VITE_VAPID_PUBLIC_KEY=
