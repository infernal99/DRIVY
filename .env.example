# Copy this file to .env.local (git-ignored — never commit real values there)
# and fill in the two Supabase values. Ask Ian or Uri for the project's
# actual URL/publishable key if you don't have them — same values as
# whatever is set in Vercel's Environment Variables for this project.
#
# Restart `npm run dev` after creating/editing .env.local — Vite only reads
# env files at startup.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
